# Copia este fichero a `.env` y ajusta lo que necesites: `cp .env.example .env`.
# Valores de desarrollo local únicamente. Nunca credenciales reales en el repo.

NODE_ENV=development
APP_URL=http://localhost:3000

# ---------- PostgreSQL 16 (docker compose: servicio `postgres`) ----------
POSTGRES_USER=itfin360
POSTGRES_PASSWORD=itfin360
POSTGRES_DB=itfin360
POSTGRES_PORT=5432
# Conexión de la aplicación
DATABASE_URL=postgresql://itfin360:itfin360@localhost:5432/itfin360?schema=public
# Conexión usada por las migraciones (en producción es un rol distinto al de la aplicación)
MIGRATION_DATABASE_URL=postgresql://itfin360:itfin360@localhost:5432/itfin360?schema=public

# ---------- Redis 7 (docker compose: servicio `redis`) ----------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------- MinIO / almacenamiento S3 (docker compose: servicio `minio`) ----------
MINIO_ROOT_USER=itfin360
MINIO_ROOT_PASSWORD=itfin360dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=itfin360
S3_SECRET_ACCESS_KEY=itfin360dev
S3_BUCKET=itfin360-dev
S3_FORCE_PATH_STYLE=true
