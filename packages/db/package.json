{
  "name": "@itfin360/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo src/generated *.tsbuildinfo",
    "generate": "prisma generate",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && vitest run --passWithNoTests",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset",
    "rls:check": "tsx src/rls-check.cli.ts"
  },
  "devDependencies": {
    "@itfin360/config": "workspace:*",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.3",
    "eslint": "^10.9.0",
    "prisma": "^7.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.16.3"
  }
}
