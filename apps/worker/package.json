{
  "name": "@itfin360/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@itfin360/db": "workspace:*",
    "@itfin360/finance-core": "workspace:*"
  },
  "devDependencies": {
    "@itfin360/config": "workspace:*",
    "@types/node": "^22.13.0",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
