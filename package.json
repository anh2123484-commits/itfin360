{
  "name": "itfin360",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "rls:check": "turbo run rls:check",
    "db:generate": "pnpm --filter @itfin360/db run generate",
    "db:migrate": "pnpm --filter @itfin360/db run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @itfin360/db run migrate:deploy",
    "db:up": "scripts/dev-services.sh up",
    "db:down": "scripts/dev-services.sh down",
    "db:reset": "scripts/dev-services.sh reset",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@itfin360/config": "workspace:*",
    "eslint": "^10.9.0",
    "prettier": "^3.9.0",
    "turbo": "^2.10.0",
    "typescript": "^5.9.0"
  }
}
